{
  "name": "baby-feeding",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write components lib app tests",
    "test": "vitest run",
    "check": "tsc --noEmit && eslint . && vitest run",
    "test:rls": "node tests/rls.mjs",
    "test:anon": "node --env-file=.env.local tests/anon.mjs",
    "screens": "node --env-file=.env.local tests/screens.mjs",
    "build:native": "CAPACITOR=1 next build --webpack && npx cap sync ios",
    "ios": "npm run build:native && npx cap open ios",
    "test:scenarios": "node --env-file=.env.local tests/scenarios.mjs",
    "ios:release": "sh scripts/ios-release.sh"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.10",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.6.10",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "playwright": "^1.56.1",
    "postcss": "^8.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.12"
  }
}
